+/* A bounded wait command for recovery RAM disks that do not ship /bin/sleep.
+ * This path performs no device initialization or filesystem access. */
+static int sleep_command(int argc, char* argv[])
+{
+    unsigned int seconds = 0;
+    const char* digit;
+    if (argc != 3 || strcmp(argv[1], "--sleep") || !argv[2][0])
+        goto invalid;
+    for (digit = argv[2]; *digit; ++digit)
+    {
+        if (*digit < '0' || *digit > '9')
+            goto invalid;
+        seconds = seconds * 10 + (unsigned int)(*digit - '0');
+        if (seconds > 3600)
+            goto invalid;
+    }
+    /* sleep returns the unelapsed seconds when interrupted by a signal. */
+    while (seconds)
+        seconds = sleep(seconds);
+    return 0;
+invalid:
+    fprintf(stderr, "Usage: restored_external --sleep SECONDS (0..3600)\n");
+    return 2;
+}
+
+/* Update only the existing HFS RAM root. mount_hfs tries to reopen /dev/md0
+ * for a volume-header probe and prints EBUSY even when its update succeeds.
+ * Use the matching XNU HFS arguments without that redundant raw-device open. */
+static int make_ramdisk_writable(void)
+{
+    struct statfs rootfs;
+    struct hfs_mount_args args;
+    struct stat rootstat, ramstat;
+    if (statfs("/", &rootfs) != 0) {
+        perror("Checking RAM disk root");
+        return 1;
+    }
+    if (strcmp(rootfs.f_mntonname, "/") ||
+        strcmp(rootfs.f_fstypename, "hfs") || !(rootfs.f_flags & MNT_ROOTFS)) {
+        fprintf(stderr, "Refusing to update an unexpected root filesystem\n");
+        return 1;
+    }
+    /* XNU calls the initial mount "root_device" until userspace updates it.
+       Validate the actual device identity, never that placeholder label. */
+    if (stat("/", &rootstat) != 0 || stat("/dev/md0", &ramstat) != 0) {
+        perror("Checking RAM disk device identity");
+        return 1;
+    }
+    if (!S_ISBLK(ramstat.st_mode) || rootstat.st_dev != ramstat.st_rdev) {
+        fprintf(stderr, "Root filesystem is not the /dev/md0 RAM disk\n");
+        return 1;
+    }
+    if (!(rootfs.f_flags & MNT_RDONLY))
+        return 0;
+
+    memset(&args, 0, sizeof(args));
+    args.fspec = "/dev/md0";
+    /* VNOVAL preserves the existing ownership, mask, encoding and timezone. */
+    args.hfs_uid = (uid_t)-1;
+    args.hfs_gid = (gid_t)-1;
+    args.hfs_mask = (mode_t)-1;
+    args.hfs_encoding = (u_int32_t)-1;
+    args.hfs_timezone.tz_minuteswest = -1;
+    int flags = (rootfs.f_flags & MNT_VISFLAGMASK & ~MNT_RDONLY) | MNT_UPDATE;
+    if (mount("hfs", "/", flags, &args) != 0) {
+        perror("Making RAM disk root writable");
+        return 1;
+    }
+    if (statfs("/", &rootfs) != 0 || (rootfs.f_flags & MNT_RDONLY)) {
+        fprintf(stderr, "RAM disk root is still not writable\n");
+        return 1;
+    }
+    return 0;
+}
